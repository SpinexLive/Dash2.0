{
  "name": "hll-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Hell Let Loose clan web dashboard (Next.js + NestJS + Discord bot + PostgreSQL)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm --workspace packages/shared run build && npm --workspace packages/db run build",
    "predev": "npm run build:packages",
    "dev": "concurrently -n api,bot,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:bot\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:bot": "npm --workspace apps/bot run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "db:generate": "npm --workspace packages/db run generate",
    "db:migrate": "npm --workspace packages/db run migrate",
    "db:studio": "npm --workspace packages/db run studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
