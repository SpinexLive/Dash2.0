# Copy this file to .env on the VPS, then fill in the secrets.

# ===== General =====
NODE_ENV=production

# ===== PostgreSQL =====
POSTGRES_USER=hll
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=hll_dashboard
DATABASE_URL=postgresql://hll:change_me_strong_password@postgres:5432/hll_dashboard?schema=public

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== Public URLs =====
API_PORT=4000
API_PUBLIC_URL=http://45.151.81.182:4000
WEB_PUBLIC_URL=http://45.151.81.182:3000

# ===== Auth cookies / JWT =====
JWT_SECRET=change_me_long_random_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ===== Docker port bindings =====
# Keep Postgres and Redis private. Expose web and API for the browser.
POSTGRES_PORT_BIND=127.0.0.1:5432:5432
REDIS_PORT_BIND=127.0.0.1:6379:6379
API_PORT_BIND=4000:4000
WEB_PORT_BIND=3000:3000

# ===== Discord OAuth2 =====
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_OAUTH_REDIRECT=http://45.151.81.182:3000/callback
DISCORD_REDIRECT_URI_LOCAL=http://localhost:3000/callback
DISCORD_REDIRECT_URI_VPS=http://45.151.81.182:3000/callback
DISCORD_OAUTH_SCOPES=identify guilds guilds.members.read

# ===== Discord Bot =====
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id

# ===== CRCON =====
CRCON_BASE_URL=https://your-crcon-host
CRCON_API_KEY=your_crcon_api_key

# ===== RaidHelper =====
RAIDHELPER_API_KEY=your_raidhelper_api_key

# ===== Steam Web API =====
STEAM_WEB_API_KEY=your_steam_web_api_key

# ===== Recruit intake =====
RECRUIT_POLL_CRON=*/5 * * * *
RECRUIT_WINDOW_MINUTES=15

# ===== Front-end =====
NEXT_PUBLIC_API_URL=http://45.151.81.182:4000
