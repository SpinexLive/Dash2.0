# ===== General =====
NODE_ENV=development

# ===== PostgreSQL =====
POSTGRES_USER=hll
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=hll_dashboard
# Used by Prisma / API (inside docker use host "postgres")
DATABASE_URL=postgresql://hll:change_me_strong_password@localhost:5432/hll_dashboard?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== API =====
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# JWT
JWT_SECRET=change_me_long_random_secret
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ===== Docker port bindings =====
# Local default keeps services on this machine only.
# On VPS set WEB_PORT_BIND=3000:3000 so http://SERVER_IP:3000 works.
POSTGRES_PORT_BIND=127.0.0.1:5432:5432
REDIS_PORT_BIND=127.0.0.1:6379:6379
API_PORT_BIND=127.0.0.1:4000:4000
WEB_PORT_BIND=127.0.0.1:3000:3000

# ===== Discord OAuth2 (per-user login) =====
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
# The web app proxies /callback to the API OAuth handler.
DISCORD_OAUTH_REDIRECT=http://localhost:3000/callback
DISCORD_REDIRECT_URI_LOCAL=http://localhost:3000/callback
DISCORD_REDIRECT_URI_VPS=http://45.151.81.182:3000/callback
# Scopes requested at login
DISCORD_OAUTH_SCOPES=identify guilds guilds.members.read

# ===== Discord Bot (server-side automation) =====
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id

# ===== CRCON (Hell Let Loose game server stats) =====
CRCON_BASE_URL=https://your-crcon-host
CRCON_API_KEY=your_crcon_api_key

# ===== RaidHelper =====
RAIDHELPER_API_KEY=your_raidhelper_api_key

# ===== Steam Web API =====
STEAM_WEB_API_KEY=your_steam_web_api_key

# ===== Recruit intake =====
RECRUIT_POLL_CRON=*/5 * * * *   # every 5 minutes
RECRUIT_WINDOW_MINUTES=15

# ===== Front-end (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:4000
